# ─── Local machine (.env in the project root) ────────────────────────────
# Used by both `bun run dev` and `docker compose up`.
SSH_HOST=192.168.1.10
SSH_USER=youruser
SSH_KEY_PATH=/home/you/.ssh/id_ed25519
# SSH_KEY_PASSPHRASE=          # only if the key has a passphrase
SSH_HOST_KEY_SHA256=SHA256:replace-me
# ORIGIN defaults to http://localhost:3010 for compose (open it as localhost, not 127.0.0.1)

# ─── Server (.env next to compose.yaml) ──────────────────────────────────
# SERVER_IMAGE=ghcr.io/your-github-user/server:latest
# SERVER_PORT=3010             # host port on 127.0.0.1; change if 3010 is taken
# ORIGIN=https://server.example.com
# SSH_HOST=host.docker.internal
# SSH_USER=youruser
# SSH_KEY_PATH=./secrets/ssh_key
# SSH_HOST_KEY_SHA256=SHA256:replace-me
